# ============================================================
#  .env  —  Configuración del agente de monitoreo de vuelos
#  Copiá este archivo como .env y completá tus valores reales.
#  NUNCA commitees .env al repositorio.
# ============================================================

# ── Google Flights real mediante SerpApi ──────────────────
# Es la fuente principal de Flight Sentinel V2.
PRICE_PROVIDER=serpapi
SERPAPI_API_KEY=

# Techo de salidas de ida a explorar. Con 15, si Google devuelve 9 salidas,
# se exploran las 9 (no se consumen 15 obligatoriamente).
SERPAPI_MAX_OUTBOUND_TOKENS=15
SERPAPI_COMBINE_ORIGINS=true

# ── Política base ─────────────────────────────────────────
ORIGINS=EZE,AEP
# Destino legacy/default; cada monitor de monitors.yaml puede elegir otro IATA.
DESTINATION=MIA
MAX_STOPS=1
MAX_LAYOVER_HOURS=2

# Las fechas de cada monitor se cargan desde el dashboard en DD/MM/AAAA.
# No hace falta definir DATE_OUTBOUND / DATE_RETURN en .env.

# ── Umbrales de alerta ────────────────────────────────────
ALERT_ABSOLUTE_DROP=50    # USD de caída mínima para alertar
ALERT_PERCENT_DROP=5      # % de caída mínima para alertar
ALERT_MODE=either         # either | absolute | percent | both
BASELINE_MODE=min         # first | min
ALERT_MIN_HOURS_BETWEEN=6 # horas mínimas entre alertas

# ── Email / SMTP ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail   # Usar "App Password", no contraseña normal
EMAIL_FROM=tu_email@gmail.com
EMAIL_TO=destinatario@example.com        # Separar varios con coma
EMAIL_SUBJECT_PREFIX=[Flight Sentinel]

# ── Scheduler (modo daemon) ───────────────────────────────
CHECK_INTERVAL_MINUTES=60

# ── Persistencia ─────────────────────────────────────────
DB_PATH=flight_monitor.db

# ── V2.3: Google expandido ──────────────────────────────────
# Incluye resultados ocultos equivalentes a "Ver más vuelos" en Google Flights.
SERPAPI_SHOW_HIDDEN=true
SERPAPI_GL=ar
SERPAPI_HL=es

# ── V2.3: auditoría de mercado 100% gratuita ────────────────
# Consulta Despegar con Playwright + tu Chrome local. No usa API key ni tarjeta.
MARKET_AUDIT_ENABLED=true
# Despegar puede bloquear Playwright. Por defecto sólo se audita manualmente.
MARKET_AUDIT_AUTO=false
DESPEGAR_HEADLESS=true
DESPEGAR_TIMEOUT_SECONDS=50
DESPEGAR_MAX_SCROLLS=14

# Si hay una baja de precio pero Despegar contradice/no valida la cobertura,
# conserva el dato en histórico pero no dispara la alerta como "mejor mercado".
MARKET_ALERT_REQUIRE_VALIDATION=true

# ── V2.3.3: detalle de equipaje de tarifas destacadas ─────────────
# Consulta Google Flights Booking Options sólo para un conjunto representativo
# de ofertas (mejor general + las necesarias para cubrir aerolíneas distintas).
# Cada verificación puede consumir 1 búsqueda adicional del free tier SerpApi.
SERPAPI_BAGGAGE_ENRICH=true
SERPAPI_BAGGAGE_MAX_OFFERS=6


# ── V2.5: automatización WATCH → VERIFY → AUDIT ─────────────
# WATCH usa Fli y no consume SerpApi. Estos umbrales determinan cuándo
# un cambio observado merece verificación exacta con SerpApi.
WATCH_PRICE_ABS_CHANGE=25
WATCH_PRICE_PERCENT_CHANGE=1
WATCH_VERIFY_MAX_OFFERS=2
# Consulta completa: verifica hasta 4 ofertas representativas (máx. 1 por aerolínea nueva)
AUDIT_VERIFY_MAX_OFFERS=4

# Guardia de costo: en automático nunca se supera este techo mensual.
# Con una cuenta Free de 250, 220 deja 30 búsquedas reservadas para uso manual.
SERPAPI_AUTO_MONTHLY_CAP=220
SERPAPI_MANUAL_RESERVE=30
